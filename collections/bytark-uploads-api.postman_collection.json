  "info": {
    "_postman_id": "d14943bf-75b6-4392-857b-f883c3f74ed3",
    "name": "ByteArk Live Uploads API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Representative OpenAPI description of ByteArk's public developer surfaces: the Stream Video-on-Demand API (create / upload / list / get videos) and the Fleet Live Streaming (live transcode) API. S3-compatible Storage and CDN delivery are documented separately by ByteArk; the Storage service is accessed via standard S3 clients and is not fully re-specified here.\n\nContact Support:\n Name: ByteArk Support",
      "type": "text/plain"
    }
  }
